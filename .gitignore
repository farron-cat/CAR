# ============================================
# 1. 完全忽略输出目录（OUT 下所有内容）
# ============================================
OUT/
OUT/**/*

# ============================================
# 2. 递归忽略所有 Keil 编译生成物（无论在哪里）
# ============================================
**/*.obj          # 目标文件
**/*.o            # 目标文件（GCC兼容）
**/*.lst          # 列表文件
**/*.m51          # 内存映射（C51）
**/*.map          # 内存映射（通用）
# **/*.hex          # Intel HEX
**/*.bin          # 二进制
**/*.axf          # ARM/Keil 可执行
**/*.elf          # ELF 可执行
**/*.sct          # 分散加载文件（自动生成）
**/*.scr          # 脚本临时文件
**/*.lnp          # 链接器临时文件
**/*.plg          # 编译日志
**/*.htm          # HTML 报告
**/*.tra          # 跟踪文件
**/*.crf          # 交叉引用
**/*.dep          # 依赖文件
**/*.d            # 依赖文件（GCC）
**/*.i            # 预处理输出
**/*.src          # 汇编源码（由编译器生成）
**/*.lmp          # 链接器映射
**/*.sym          # 符号文件
**/*.dbg          # 调试信息
**/*.pwi          # 调试器配置文件
**/*.crun         # 运行时信息

# ============================================
# 3. 忽略 Keil 项目中的用户配置（但保留项目主文件）
# ============================================
**/*.uvopt        # 旧版用户选项
**/*.uvoptx       # 新版用户选项（调试设置、断点）
**/*.uvguix       # GUI 窗口布局
**/*.uvguix.*     # 多用户布局文件
**/*.uvadmin      # 管理员配置
**/*.dbgconf      # 调试配置
**/DebugConfig/   # 调试配置目录
**/DebugConfig/**/*

# ============================================
# 4. 忽略常见的构建临时目录（防止漏网）
# ============================================
**/Objects/
**/Objects/**/*
**/Listings/
**/Listings/**/*
**/Output/
**/Output/**/*
**/RTE/           # RTE 环境可能生成临时文件
**/RTE/**/*

# ============================================
# 5. 忽略 VS Code 个人配置（可选，若想共享则注释掉）
# ============================================
.vscode/*.code-workspace
.vscode/workspace-storage/
.vscode/argv.json

# ============================================
# 6. 忽略操作系统和编辑器垃圾
# ============================================
Thumbs.db
.DS_Store
*.bak
*~
*.tmp
*.log
*.swp
*.swo
*.swn
*.suo
*.user
*.cache
*.pdb
*.ilk
*.exp
*.lib          # 注意：如果项目中有静态库源码，请移除该行；否则忽略生成的库文件